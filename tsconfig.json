{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node",
    "lib": ["esnext", "dom"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": true,
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "rootDir": "./src",
    "outDir": "./build",
    "paths": {
      "io-gui": ["./lib/io-gui/"],
    }
  },
  "include": ["./src"]
}
